<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 13+「主题图标」用的单色层。

  规则：只能有一个颜色的剪影，系统会把它染成壁纸配色。所以这里全部用纯黑填充，
  不能用原来的焦橙 + 深色描边（那会被系统当成多色而失效，图标变灰块）。
  笔头那道勾在剪影里必须粗一点，否则缩小后会糊掉。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">

    <!-- 缩放 0.667 是量出来的，不是拍的：
         自适应图标的可见区只有画布的 72/108 = 0.667，所以画布里的东西
         会再被放大 1.5 倍显示。老图标那版（用户认可的观感）笔宽占图标 57%，
         换算回画布就是 57% × 0.667 ≈ 38%，而笔的原生宽度是 58%
         → 需要 0.38 / 0.58 ≈ 0.667。绕了一圈，数值正好等于可见区比例。

         pivot 取的是**笔迹外接框的真实中心 (523, 518)**，不是画布中心 ——
         取错的话缩放会把笔带偏（前一版就偏了 15%）。 -->
    <group
        android:pivotX="523"
        android:pivotY="518"
        android:scaleX="0.667"
        android:scaleY="0.667"
        android:translateX="-11"
        android:translateY="-6">

        <path
            android:fillColor="#FF000000"
            android:pathData="M226,692 C352,674 440,616 490,519 C535,431 565,364 650,320 C700,294 757,302 789,334 C826,372 820,427 783,468 C738,517 662,525 606,561 C520,616 474,706 357,731 C306,742 264,736 226,727 Z" />

        <path
            android:fillColor="@android:color/transparent"
            android:strokeColor="#FF000000"
            android:strokeWidth="46"
            android:strokeLineCap="round"
            android:pathData="M622,326 C677,279 734,262 776,303 C816,342 800,398 757,432 C714,466 676,470 636,453" />
    </group>
</vector>
