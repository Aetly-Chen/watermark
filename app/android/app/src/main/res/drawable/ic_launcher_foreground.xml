<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标（Android 8.0 / API 26+）的前景层：只有那支修复笔，不带底色。

  ## 为什么把底色拿掉
  原来整块 1024 画布（含奶油圆角矩形）一起当 `android:icon` 用，系统会按「老图标」
  处理：先给它垫一层白底、再整体缩小到约 72%。结果就是笔偏小、四周一圈白，
  和系统里其它图标不一个风格。拆成「背景层 + 前景层」后，底色由背景层负责，
  启动器只裁形状，不再垫白底。

  ## 居中的道理
  自适应图标的 108dp 画布只有中间 72dp 可见，安全区 66dp。
  笔在原始 1024 画布上的外接框是 x 226..820、y 294..742（宽 594 / 高 448），
  中心在 (523, 518)，而画布中心是 (512, 512) —— 所以整体往左上挪 11 / 6，
  笔才会视觉居中，而不是靠右下。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">

    <!-- 缩放 0.667 是量出来的，不是拍的：
         自适应图标的可见区只有画布的 72/108 = 0.667，所以画布里的东西
         会再被放大 1.5 倍显示。老图标那版（用户认可的观感）笔宽占图标 57%，
         换算回画布就是 57% × 0.667 ≈ 38%，而笔的原生宽度是 58%
         → 需要 0.38 / 0.58 ≈ 0.667。绕了一圈，数值正好等于可见区比例。

         pivot 取的是**笔迹外接框的真实中心 (523, 518)**，不是画布中心 ——
         取错的话缩放会把笔带偏（前一版就偏了 15%）。 -->
    <group
        android:pivotX="523"
        android:pivotY="518"
        android:scaleX="0.667"
        android:scaleY="0.667"
        android:translateX="-11"
        android:translateY="-6">

        <!-- 笔身 -->
        <path
            android:fillColor="#C4551B"
            android:pathData="M226,692 C352,674 440,616 490,519 C535,431 565,364 650,320 C700,294 757,302 789,334 C826,372 820,427 783,468 C738,517 662,525 606,561 C520,616 474,706 357,731 C306,742 264,736 226,727 Z" />

        <!-- 笔头的深色勾 -->
        <path
            android:fillColor="@android:color/transparent"
            android:strokeColor="#1B1A17"
            android:strokeWidth="38"
            android:strokeLineCap="round"
            android:pathData="M622,326 C677,279 734,262 776,303 C816,342 800,398 757,432 C714,466 676,470 636,453" />

        <!-- 笔身上的一道高光 -->
        <path
            android:fillColor="@android:color/transparent"
            android:strokeColor="#FFFDF8"
            android:strokeWidth="28"
            android:strokeLineCap="round"
            android:pathData="M355,690 C385,636 429,599 487,579" />
    </group>
</vector>
